# ---- 大模型（可留空，留空时 AI 助手走本地规则，功能不受影响）----
# 环境变量优先级高于 config/deepseek.key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=4096

# ---- 服务 ----
# 默认监听 127.0.0.1:5000；如需局域网访问改成 0.0.0.0 并注意防火墙
APP_HOST=127.0.0.1
APP_PORT=5000

# ---- 运行可选参数（不填则读 config/default.yaml）----
# SIM_RANDOM_SEED=42
# SIM_SERVICE_RATE_FLOOR=0.98
