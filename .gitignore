# ---- 原始数据快照（体量大且版权归发布方，只入库派生统计量）----
data/raw/

# ---- 密钥（绝不入库）----
config/deepseek.key
.env

# ---- 运行日志（含客户端 UA / IP，不入库）----
data/download_stats.json

# ---- 账号库与运行索引（含个人账号信息）----
data/users.db
data/users.db-shm
data/users.db-wal
data/.session_secret

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

